# Build output — regenerated by `make` and by CI.
dist/

# Personal Claude Code overrides, not shared.
.claude/settings.local.json

.DS_Store

# Local render toolchain, created by `make setup`.
.venv/

# The generated CV. roles/*.md is the source of truth; this is written by
# /generate-cv and then edited by hand for a particular application, so it is a
# working file rather than something to keep. Anything in here worth keeping
# belongs back in roles/*.md.
cv.md

# Job specs pulled down by /generate-cv, and any kept by hand alongside them -
# transient, not ours to publish, and they carry the salary figures this repo
# keeps out. The glob covers the suffixed ones (.job-spec-acme.txt) too: an
# exact filename here left every spec but one committable.
.job-spec*

# Real contact details. .env.example carries placeholders; this never gets committed.
.env

# Application records. One file per application, carrying the advertised salary,
# the requirements an assessment found missing, and whatever a rejection said -
# none of which belongs in a public repo. TEMPLATE.md is the exception and is
# committed, because it is placeholders only and a fresh clone needs the shape.
applications/*
!applications/TEMPLATE.md

# Playwright, for the find-jobs browser fetcher - installed locally from the
# package.json beside it, never committed.
node_modules/

# The find-jobs sweep's two standing lists: who is being asked to place me, and
# who I want to work for. Neither is a public fact, and both are edited between
# runs without touching the skill. The .example.md files beside them carry
# placeholders only and are committed, because a fresh clone needs the shape.
.claude/skills/find-jobs/RECRUITERS.md
.claude/skills/find-jobs/COMPANIES.md
